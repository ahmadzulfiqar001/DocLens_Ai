# Streamlit Secrets Configuration Example
# Copy this file to .streamlit/secrets.toml and replace placeholders with your actual keys.
# NEVER commit .streamlit/secrets.toml to version control (it is ignored in .gitignore).

# Google Gemini API Key (Get yours free from https://aistudio.google.com/apikey)
GEMINI_API_KEY = "your_gemini_api_key_here"

# Optional: Default model override (Supported: gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-flash)
GEMINI_MODEL = "gemini-2.5-flash"
