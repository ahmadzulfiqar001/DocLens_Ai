# Streamlit Secrets Configuration Example
# Copy this file to .streamlit/secrets.toml and replace placeholders with your actual keys.
# NEVER commit .streamlit/secrets.toml to version control (it is ignored in .gitignore).

# Groq API Key (Get yours from https://console.groq.com/keys)
GROQ_API_KEY = "gsk_your_groq_api_key_here"

# Optional: Default model override (Supported: llama-3.3-70b-versatile, llama-3.1-8b-instant)
GROQ_MODEL = "llama-3.3-70b-versatile"

